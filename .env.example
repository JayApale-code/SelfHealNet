# .env.example - Environment Variables Template

# ==================== Application ====================
ENVIRONMENT=development
APP_NAME=SelfHealNet
APP_VERSION=1.0.0

# ==================== Database ====================
DATABASE_URL=mysql+pymysql://selfhealnet:password@localhost:3306/selfhealnet
# For lightweight/local testing: sqlite:///./selfhealnet.db

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== API ====================
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-in-production

# ==================== Monitoring ====================
MONITORING_INTERVAL=30
METRIC_RETENTION_DAYS=30
# Set this to a real reachable host/IP to enable TCP latency measurement.
# MONITORING_TARGET=1.1.1.1
# MONITORING_TARGET_PORT=80

# ==================== ML Model ====================
MODEL_PATH=data/models/fault_prediction_model.joblib
PREDICTION_THRESHOLD=0.7

# ==================== Recovery ====================
RECOVERY_TIMEOUT=300
FALLBACK_ENABLED=true
SAFETY_CHECK_ENABLED=true

# ==================== SDN Controller ====================
SDN_CONTROLLER_URL=http://127.0.0.1:8080
SDN_WSL_DISTRIBUTION=Ubuntu-22.04
SDN_CONTROLLER_REST_HOST=127.0.0.1
SDN_CONTROLLER_REST_PORT=8080
SDN_CONTROLLER_API_TIMEOUT_SECONDS=2
SDN_RETRY_INTERVAL_SECONDS=5
SDN_PROTOCOL=openflow
SDN_CONTROLLER_TYPE=os_ken_lab
SDN_OPENFLOW_HOST=127.0.0.1
SDN_OPENFLOW_PORT=6633
SDN_OPENFLOW_VERSION=OpenFlow13
SDN_SIMULATION_ENABLED=false

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FILE=logs/selfhealnet.log

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
